<%- include('partials/app-start') %>
<script>Auth.guard('admin');</script>
<div class="page-head">
    <div><h1>Dashboard de administrador</h1><p>Resumen y gestión de los usuarios registrados.</p></div>
</div>
<div class="stats">
    <div class="panel stat"><span class="ico tone-blue"><i class="material-icons">groups</i></span>
        <div><div class="label">Total de usuarios</div><div class="value" id="sTotal">0</div></div></div>
    <div class="panel stat"><span class="ico tone-red"><i class="material-icons">admin_panel_settings</i></span>
        <div><div class="label">Administradores</div><div class="value" id="sAdmins">0</div></div></div>
    <div class="panel stat"><span class="ico tone-green"><i class="material-icons">person</i></span>
        <div><div class="label">Usuarios estándar</div><div class="value" id="sUsers">0</div></div></div>
    <div class="panel stat"><span class="ico tone-amber"><i class="material-icons">person_add_alt</i></span>
        <div><div class="label">Nuevos (7 días)</div><div class="value" id="sNew">0</div></div></div>
</div>
<div class="panel">
    <div class="panel-head">
        <div><h3>Usuarios</h3><p id="count">Cargando…</p></div>
        <div class="search"><i class="material-icons">search</i>
            <input id="q" class="input browser-default" type="search" placeholder="Buscar por nombre o correo"></div>
    </div>
    <div class="table-wrap">
        <table class="data">
            <thead>
                <tr><th>Usuario</th><th>Teléfono</th><th>Edad</th><th>Roles</th><th>Fecha de registro</th><th>Estado</th><th></th></tr>
            </thead>
            <tbody id="users"></tbody>
        </table>
    </div>
</div>
<script>
    let users = [];

    function render() {
        const q = document.getElementById('q').value.trim().toLowerCase();
        const list = users.filter(u => `${u.name} ${u.lastName} ${u.email}`.toLowerCase().includes(q));
        document.getElementById('count').textContent = `Mostrando ${list.length} de ${users.length} usuarios`;
        document.getElementById('users').innerHTML = list.length ? list.map(u => `
            <tr>
                <td><div class="person"><img src="${Fmt.avatar(u)}" alt="">
                    <div><b>${Fmt.esc(u.name)} ${Fmt.esc(u.lastName)}</b><span>${Fmt.esc(u.email)}</span></div></div></td>
                <td>${Fmt.esc(u.phoneNumber)}</td>
                <td>${u.age ?? '—'}</td>
                <td>${u.roles.map(r => `<span class="badge-role ${r}">${r}</span>`).join('')}</td>
                <td>${Fmt.date(u.createdAt)}<br><span class="muted">${new Date(u.createdAt).toLocaleTimeString('es-PE', { hour: '2-digit', minute: '2-digit' })}</span></td>
                <td><span class="status-dot">Activo</span></td>
                <td><a class="btn-small btn-outline waves-effect" href="/admin/users/${u.id}"><i class="material-icons left">visibility</i>Ver</a></td>
            </tr>`).join('') : `<tr><td colspan="7" class="empty">No se encontraron usuarios</td></tr>`;
    }

    (async () => {
        users = await Auth.api('/api/users');
        const weekAgo = Date.now() - 7 * 24 * 60 * 60 * 1000;
        document.getElementById('sTotal').textContent = users.length;
        document.getElementById('sAdmins').textContent = users.filter(u => u.roles.includes('admin')).length;
        document.getElementById('sUsers').textContent = users.filter(u => !u.roles.includes('admin')).length;
        document.getElementById('sNew').textContent = users.filter(u => new Date(u.createdAt) >= weekAgo).length;
        render();
    })();
    document.getElementById('q').addEventListener('input', render);
</script>
<%- include('partials/app-end') %>
