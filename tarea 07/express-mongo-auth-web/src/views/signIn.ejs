<%- include('partials/head') %>
<script>Auth.guard('guest');</script>
<div class="auth">
    <%- include('partials/brand') %>
    <main class="auth-panel">
        <div class="auth-box">
            <h2>Iniciar sesión</h2>
            <p class="sub">Ingresa tus credenciales para acceder al portal.</p>
            <div id="error" class="alert"><i class="material-icons">error_outline</i><span></span></div>
            <form id="signInForm" novalidate>
                <div class="field">
                    <label for="email">Correo electrónico</label>
                    <div class="control"><i class="material-icons">mail_outline</i>
                        <input id="email" class="input browser-default" type="email" placeholder="nombre@empresa.com" autocomplete="username" required></div>
                </div>
                <div class="field">
                    <label for="password">Contraseña</label>
                    <div class="control"><i class="material-icons">lock_outline</i>
                        <input id="password" class="input browser-default" type="password" placeholder="••••••••" autocomplete="current-password" required></div>
                </div>
                <button class="btn-large waves-effect waves-light" style="width:100%;margin-top:8px" type="submit">Ingresar</button>
            </form>
            <p class="switch">¿No tienes una cuenta? <a href="/signUp">Crear cuenta</a></p>
        </div>
    </main>
</div>
<script>
    const params = new URLSearchParams(location.search);
    const showError = msg => {
        const el = document.getElementById('error');
        el.querySelector('span').textContent = msg;
        el.classList.toggle('show', !!msg);
    };
    document.addEventListener('DOMContentLoaded', () => {
        if (params.get('registered')) toast('Cuenta creada correctamente. Ya puedes iniciar sesión.');
        if (params.get('reason') === 'expired') toast('Tu sesión expiró. Vuelve a iniciar sesión.', 'warn');
    });

    document.getElementById('signInForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        showError('');
        try {
            const { token } = await Auth.api('/api/auth/signIn', {
                method: 'POST',
                body: JSON.stringify({
                    email: document.getElementById('email').value.trim(),
                    password: document.getElementById('password').value
                })
            });
            Auth.setToken(token);
            window.location.replace(Auth.homePath());
        } catch (err) {
            showError(err.message);
        }
    });
</script>
<%- include('partials/foot') %>
