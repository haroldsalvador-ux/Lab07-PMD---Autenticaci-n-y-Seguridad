<%- include('partials/head') %>
<script>Auth.guard('auth');</script>
<div class="container">
    <h4>Mi cuenta</h4>
    <div class="card"><div class="card-content">
        <form id="profileForm" novalidate>
            <div class="row">
                <div class="input-field col s12 m6">
                    <input id="email" type="email" disabled>
                    <label for="email" class="active">Email (no editable)</label>
                </div>
                <div class="input-field col s12 m6">
                    <input id="roles" type="text" disabled>
                    <label for="roles" class="active">Roles</label>
                </div>
                <div class="input-field col s12 m6">
                    <input id="name" type="text">
                    <label for="name" class="active">Nombre</label>
                </div>
                <div class="input-field col s12 m6">
                    <input id="lastName" type="text">
                    <label for="lastName" class="active">Apellido</label>
                </div>
                <div class="input-field col s12 m6">
                    <input id="phoneNumber" type="tel">
                    <label for="phoneNumber" class="active">Teléfono</label>
                </div>
                <div class="input-field col s12 m4">
                    <input id="birthdate" type="date">
                    <label for="birthdate" class="active">Fecha de nacimiento</label>
                </div>
                <div class="input-field col s12 m2">
                    <input id="age" type="text" disabled>
                    <label for="age" class="active">Edad</label>
                </div>
                <div class="input-field col s12 m6">
                    <input id="address" type="text">
                    <label for="address" class="active">Dirección</label>
                </div>
                <div class="input-field col s12 m6">
                    <input id="url_profile" type="url">
                    <label for="url_profile" class="active">URL foto de perfil</label>
                </div>
            </div>
            <button class="btn waves-effect indigo darken-2" type="submit"><i class="material-icons left">save</i>Guardar cambios</button>
        </form>
    </div></div>
</div>
<script>
    const FIELDS = ['name', 'lastName', 'phoneNumber', 'birthdate', 'address', 'url_profile'];
    const $ = id => document.getElementById(id);

    function fill(u) {
        $('email').value = u.email;
        $('roles').value = u.roles.join(', ');
        $('age').value = u.age != null ? `${u.age} años` : '';
        FIELDS.forEach(f => $(f).value = f === 'birthdate' ? (u.birthdate || '').slice(0, 10) : (u[f] ?? ''));
        M.updateTextFields();
    }

    (async () => fill(await Auth.api('/api/users/me')))();

    $('profileForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = Object.fromEntries(FIELDS.map(f => [f, $(f).value.trim()]));
        try {
            fill(await Auth.api('/api/users/me', { method: 'PUT', body: JSON.stringify(data) }));
            M.toast({ html: 'Datos actualizados', classes: 'green' });
        } catch (err) {
            M.toast({ html: err.message, classes: 'red' });
        }
    });
</script>
<%- include('partials/foot') %>
