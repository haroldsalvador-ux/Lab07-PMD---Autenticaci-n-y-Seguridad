<%- include('partials/app-start') %>
<script>Auth.guard('auth');</script>
<div class="page-head">
    <div><h1>Mi cuenta</h1><p>Consulta y actualiza tu información personal.</p></div>
</div>
<div class="layout-2">
    <div class="panel profile-card">
        <img id="avatar" alt="">
        <h3 id="fullName">&nbsp;</h3>
        <div class="mail" id="pEmail"></div>
        <div id="pRoles"></div>
        <div class="meta">
            <div><span>Edad</span><b id="pAge">—</b></div>
            <div><span>Registrado</span><b id="pCreated">—</b></div>
            <div><span>Estado</span><span class="status-dot">Activo</span></div>
        </div>
    </div>
    <form id="profileForm" class="panel" novalidate>
        <div class="form-section">
            <h4>Información personal</h4>
            <p>Tu nombre y fecha de nacimiento.</p>
            <div class="grid-2">
                <div class="field"><label for="name">Nombre</label><input id="name" class="input browser-default" type="text"></div>
                <div class="field"><label for="lastName">Apellido</label><input id="lastName" class="input browser-default" type="text"></div>
                <div class="field"><label for="birthdate">Fecha de nacimiento</label><input id="birthdate" class="input browser-default" type="date"></div>
                <div class="field"><label for="url_profile">URL foto de perfil</label><input id="url_profile" class="input browser-default" type="url" placeholder="https://..."></div>
            </div>
        </div>
        <div class="form-section">
            <h4>Contacto</h4>
            <p>Medios para comunicarnos contigo.</p>
            <div class="grid-2">
                <div class="field"><label for="email">Correo electrónico</label><input id="email" class="input browser-default" type="email" disabled></div>
                <div class="field"><label for="phoneNumber">Teléfono</label><input id="phoneNumber" class="input browser-default" type="tel"></div>
            </div>
            <div class="field"><label for="address">Dirección</label><input id="address" class="input browser-default" type="text"></div>
        </div>
        <div class="form-actions">
            <a href="/dashboard" class="btn btn-outline waves-effect">Cancelar</a>
            <button class="btn waves-effect waves-light" type="submit"><i class="material-icons left">save</i>Guardar cambios</button>
        </div>
    </form>
</div>
<script>
    const FIELDS = ['name', 'lastName', 'phoneNumber', 'birthdate', 'address', 'url_profile'];
    const $ = id => document.getElementById(id);

    function fill(u) {
        $('avatar').src = Fmt.avatar(u);
        $('fullName').textContent = `${u.name} ${u.lastName}`;
        $('pEmail').textContent = u.email;
        $('pRoles').innerHTML = u.roles.map(r => `<span class="badge-role ${r}">${r}</span>`).join('');
        $('pAge').textContent = u.age != null ? `${u.age} años` : '—';
        $('pCreated').textContent = Fmt.date(u.createdAt);
        $('email').value = u.email;
        FIELDS.forEach(f => $(f).value = f === 'birthdate' ? (u.birthdate || '').slice(0, 10) : (u[f] ?? ''));
    }

    (async () => fill(await Auth.me()))();

    $('profileForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = Object.fromEntries(FIELDS.map(f => [f, $(f).value.trim()]));
        try {
            const u = await Auth.api('/api/users/me', { method: 'PUT', body: JSON.stringify(data) });
            fill(u);
            $('tbName').textContent = `${u.name} ${u.lastName}`;
            $('tbAvatar').src = Fmt.avatar(u);
            toast('Los cambios se guardaron correctamente');
        } catch (err) {
            toast(err.message, 'err');
        }
    });
</script>
<%- include('partials/app-end') %>
