<%- include('partials/head') %>
<script>Auth.guard('auth');</script>
<div class="container">
    <h4 id="welcome">Bienvenido</h4>
    <p class="grey-text text-darken-1">Aquí están tus datos:</p>
    <div class="row">
        <div class="col s12 m4">
            <div class="card center-align">
                <div class="card-content">
                    <img id="avatar" class="avatar-big" alt="">
                    <h5 id="fullName"></h5>
                    <p id="roles"></p>
                </div>
                <div class="card-action"><a href="/profile">Editar mi cuenta</a></div>
            </div>
        </div>
        <div class="col s12 m8">
            <div class="card"><div class="card-content">
                <span class="card-title">Mis datos</span>
                <ul class="data-list" id="data"></ul>
            </div></div>
        </div>
    </div>
</div>
<script>
    (async () => {
        const u = await Auth.api('/api/users/me');
        document.getElementById('welcome').textContent = `Bienvenido, ${u.name}`;
        document.getElementById('fullName').textContent = `${u.name} ${u.lastName}`;
        document.getElementById('avatar').src = Fmt.avatar(u);
        document.getElementById('roles').innerHTML = u.roles.map(r => `<span class="new badge ${r === 'admin' ? 'red' : 'indigo'}" data-badge-caption="${r}" style="float:none"></span>`).join(' ');
        const rows = [
            ['Email', u.email], ['Teléfono', u.phoneNumber], ['Fecha de nacimiento', Fmt.date(u.birthdate)],
            ['Edad', `${u.age} años`], ['Dirección', u.address], ['Miembro desde', Fmt.dateTime(u.createdAt)]
        ];
        document.getElementById('data').innerHTML = rows.map(([k, v]) => `<li><span class="label">${k}</span><span>${Fmt.esc(v)}</span></li>`).join('');
    })();
</script>
<%- include('partials/foot') %>
