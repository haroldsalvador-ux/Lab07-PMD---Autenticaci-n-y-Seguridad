<%- include('partials/app-start') %>
<script>Auth.guard('auth');</script>
<div class="welcome">
    <img id="avatar" alt="">
    <div>
        <h2 id="welcome">Bienvenido</h2>
        <p>Aquí están tus datos. Mantén tu información actualizada desde <b>Mi cuenta</b>.</p>
    </div>
</div>
<div class="stats three">
    <div class="panel stat"><span class="ico tone-blue"><i class="material-icons">badge</i></span>
        <div><div class="label">Rol asignado</div><div class="value sm" id="sRole">—</div></div></div>
    <div class="panel stat"><span class="ico tone-green"><i class="material-icons">cake</i></span>
        <div><div class="label">Edad</div><div class="value sm" id="sAge">—</div></div></div>
    <div class="panel stat"><span class="ico tone-amber"><i class="material-icons">event_available</i></span>
        <div><div class="label">Miembro desde</div><div class="value sm" id="sSince">—</div></div></div>
</div>
<div class="panel">
    <div class="panel-head">
        <div><h3>Información personal</h3><p>Datos registrados en tu cuenta</p></div>
        <a href="/profile" class="btn btn-outline waves-effect"><i class="material-icons left">edit</i>Editar</a>
    </div>
    <dl class="dl" id="data"></dl>
</div>
<script>
    (async () => {
        const u = await Auth.me();
        document.getElementById('welcome').textContent = `Bienvenido, ${u.name}`;
        document.getElementById('avatar').src = Fmt.avatar(u);
        document.getElementById('sRole').textContent = u.roles.includes('admin') ? 'Administrador' : 'Usuario';
        document.getElementById('sAge').textContent = `${u.age} años`;
        document.getElementById('sSince').textContent = Fmt.date(u.createdAt);
        const rows = [
            ['Nombre completo', `${u.name} ${u.lastName}`], ['Correo electrónico', u.email],
            ['Teléfono', u.phoneNumber], ['Fecha de nacimiento', Fmt.date(u.birthdate)],
            ['Dirección', u.address], ['Última actualización', Fmt.dateTime(u.updatedAt)]
        ];
        document.getElementById('data').innerHTML = rows.map(([k, v]) => `<div><dt>${k}</dt><dd>${Fmt.esc(v || '—')}</dd></div>`).join('');
    })();
</script>
<%- include('partials/app-end') %>
