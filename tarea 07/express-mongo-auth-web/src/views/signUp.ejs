<%- include('partials/head') %>
<script>Auth.guard('guest');</script>
<div class="container">
    <div class="card" style="max-width:720px;margin:0 auto">
        <div class="card-content">
            <span class="card-title center-align"><i class="material-icons medium indigo-text">person_add</i><br>Crear cuenta</span>
            <form id="signUpForm" novalidate>
                <div class="row">
                    <div class="input-field col s12 m6">
                        <input id="name" type="text" required>
                        <label for="name">Nombre *</label>
                    </div>
                    <div class="input-field col s12 m6">
                        <input id="lastName" type="text" required>
                        <label for="lastName">Apellido *</label>
                    </div>
                    <div class="input-field col s12 m6">
                        <input id="phoneNumber" type="tel" required>
                        <label for="phoneNumber">Teléfono *</label>
                    </div>
                    <div class="input-field col s12 m6">
                        <input id="birthdate" type="date" required>
                        <label for="birthdate" class="active">Fecha de nacimiento *</label>
                    </div>
                    <div class="input-field col s12 m6">
                        <input id="address" type="text">
                        <label for="address">Dirección</label>
                    </div>
                    <div class="input-field col s12 m6">
                        <input id="url_profile" type="url">
                        <label for="url_profile">URL foto de perfil</label>
                    </div>
                    <div class="input-field col s12">
                        <input id="email" type="email" required>
                        <label for="email">Email *</label>
                    </div>
                    <div class="input-field col s12">
                        <input id="password" type="password" required>
                        <label for="password">Password *</label>
                    </div>
                    <p class="col s12 pass-hint">Mínimo 8 caracteres, 1 mayúscula, 1 dígito y 1 caracter especial ( # $ % &amp; * @ )</p>
                </div>
                <p id="error" class="red-text center-align"></p>
                <button class="btn-large waves-effect indigo darken-2" style="width:100%" type="submit">Registrarme</button>
            </form>
            <p class="center-align" style="margin-top:20px">¿Ya tienes cuenta? <a href="/signIn">Inicia sesión</a></p>
        </div>
    </div>
</div>
<script>
    const PASSWORD_REGEX = /^(?=.*[A-Z])(?=.*\d)(?=.*[#$%&*@]).{8,}$/;
    const val = id => document.getElementById(id).value.trim();

    document.getElementById('signUpForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const error = document.getElementById('error');
        error.textContent = '';

        const data = {
            name: val('name'), lastName: val('lastName'), phoneNumber: val('phoneNumber'),
            birthdate: val('birthdate'), address: val('address'), url_profile: val('url_profile'),
            email: val('email'), password: document.getElementById('password').value
        };
        if (!data.name || !data.lastName || !data.phoneNumber || !data.birthdate || !data.email)
            return error.textContent = 'Completa todos los campos obligatorios (*)';
        if (!PASSWORD_REGEX.test(data.password))
            return error.textContent = 'El password no cumple los requisitos';

        try {
            await Auth.api('/api/auth/signUp', { method: 'POST', body: JSON.stringify(data) });
            window.location.replace('/signIn?registered=1');
        } catch (err) {
            error.textContent = err.message;
        }
    });
</script>
<%- include('partials/foot') %>
