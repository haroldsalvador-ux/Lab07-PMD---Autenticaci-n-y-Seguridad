<%- include('partials/head') %>
<script>Auth.guard('guest');</script>
<div class="auth">
    <%- include('partials/brand') %>
    <main class="auth-panel">
        <div class="auth-box wide">
            <h2>Crear cuenta</h2>
            <p class="sub">Completa tus datos para registrarte en el portal.</p>
            <div id="error" class="alert"><i class="material-icons">error_outline</i><span></span></div>
            <form id="signUpForm" novalidate>
                <div class="grid-2">
                    <div class="field">
                        <label for="name">Nombre <span class="req">*</span></label>
                        <input id="name" class="input browser-default" type="text" placeholder="Juan" required>
                    </div>
                    <div class="field">
                        <label for="lastName">Apellido <span class="req">*</span></label>
                        <input id="lastName" class="input browser-default" type="text" placeholder="Pérez" required>
                    </div>
                    <div class="field">
                        <label for="phoneNumber">Teléfono <span class="req">*</span></label>
                        <input id="phoneNumber" class="input browser-default" type="tel" placeholder="987 654 321" required>
                    </div>
                    <div class="field">
                        <label for="birthdate">Fecha de nacimiento <span class="req">*</span></label>
                        <input id="birthdate" class="input browser-default" type="date" required>
                    </div>
                    <div class="field">
                        <label for="address">Dirección</label>
                        <input id="address" class="input browser-default" type="text" placeholder="Av. Principal 123">
                    </div>
                    <div class="field">
                        <label for="url_profile">URL foto de perfil</label>
                        <input id="url_profile" class="input browser-default" type="url" placeholder="https://...">
                    </div>
                </div>
                <div class="field">
                    <label for="email">Correo electrónico <span class="req">*</span></label>
                    <div class="control"><i class="material-icons">mail_outline</i>
                        <input id="email" class="input browser-default" type="email" placeholder="nombre@empresa.com" required></div>
                </div>
                <div class="field">
                    <label for="password">Contraseña <span class="req">*</span></label>
                    <div class="control"><i class="material-icons">lock_outline</i>
                        <input id="password" class="input browser-default" type="password" placeholder="••••••••" autocomplete="new-password" required></div>
                    <div class="hint">Mínimo 8 caracteres, 1 mayúscula, 1 dígito y 1 caracter especial ( # $ % &amp; * @ )</div>
                </div>
                <button class="btn-large waves-effect waves-light" style="width:100%;margin-top:4px" type="submit">Crear cuenta</button>
            </form>
            <p class="switch">¿Ya tienes una cuenta? <a href="/signIn">Iniciar sesión</a></p>
        </div>
    </main>
</div>
<script>
    const PASSWORD_REGEX = /^(?=.*[A-Z])(?=.*\d)(?=.*[#$%&*@]).{8,}$/;
    const val = id => document.getElementById(id).value.trim();
    const showError = msg => {
        const el = document.getElementById('error');
        el.querySelector('span').textContent = msg;
        el.classList.toggle('show', !!msg);
        if (msg) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    };

    document.getElementById('signUpForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        showError('');

        const data = {
            name: val('name'), lastName: val('lastName'), phoneNumber: val('phoneNumber'),
            birthdate: val('birthdate'), address: val('address'), url_profile: val('url_profile'),
            email: val('email'), password: document.getElementById('password').value
        };
        if (!data.name || !data.lastName || !data.phoneNumber || !data.birthdate || !data.email)
            return showError('Completa todos los campos obligatorios (*)');
        if (!PASSWORD_REGEX.test(data.password))
            return showError('La contraseña no cumple los requisitos de seguridad');

        try {
            await Auth.api('/api/auth/signUp', { method: 'POST', body: JSON.stringify(data) });
            window.location.replace('/signIn?registered=1');
        } catch (err) {
            showError(err.message);
        }
    });
</script>
<%- include('partials/foot') %>
