<%- include('partials/head') %>
<script>Auth.guard('admin');</script>
<div class="container">
    <a href="/admin" class="btn-flat"><i class="material-icons left">arrow_back</i>Volver</a>
    <div class="row" style="margin-top:16px">
        <div class="col s12 m4">
            <div class="card center-align"><div class="card-content">
                <img id="avatar" class="avatar-big" alt="">
                <h5 id="fullName"></h5>
                <p id="roles"></p>
            </div></div>
        </div>
        <div class="col s12 m8">
            <div class="card"><div class="card-content">
                <span class="card-title">Información del usuario</span>
                <ul class="data-list" id="data"></ul>
            </div></div>
        </div>
    </div>
</div>
<script>
    (async () => {
        const u = await Auth.api('/api/users/<%= userId %>');
        document.getElementById('fullName').textContent = `${u.name} ${u.lastName}`;
        document.getElementById('avatar').src = Fmt.avatar(u);
        document.getElementById('roles').innerHTML = u.roles.map(r => `<span class="chip">${r}</span>`).join('');
        const rows = [
            ['ID', u.id], ['Email', u.email], ['Teléfono', u.phoneNumber], ['Fecha de nacimiento', Fmt.date(u.birthdate)],
            ['Edad', `${u.age} años`], ['Dirección', u.address], ['URL perfil', u.url_profile],
            ['Fecha de registro', Fmt.dateTime(u.createdAt)], ['Última actualización', Fmt.dateTime(u.updatedAt)]
        ];
        document.getElementById('data').innerHTML = rows.map(([k, v]) => `<li><span class="label">${k}</span><span>${Fmt.esc(v)}</span></li>`).join('');
    })().catch(() => {});
</script>
<%- include('partials/foot') %>
